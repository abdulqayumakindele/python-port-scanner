---
import { site } from '../data/content.js';
---
<footer>
  <div>
    <strong style="color:#fff;font-size:1.05rem;">{site.brand}</strong>
    <p style="font-size:.88rem;margin-top:4px;">{site.tagline}</p>
  </div>
  <nav class="footer-links" aria-label="Footer navigation">
    <a href="/how-it-works">How It Works</a>
    <a href="/usage">Usage</a>
    <a href="/code">Source Code</a>
    <a href="/ethics">Ethical Use</a>
  </nav>
  <div class="footer-links">
    {site.links.map(([label, url]) => (
      <a href={url} target="_blank" rel="noopener noreferrer">{label} ↗<span class="sr-only"> (opens in new tab)</span></a>
    ))}
  </div>
  <small>© 2026 Abdul Qayum Akindele</small>
</footer>
