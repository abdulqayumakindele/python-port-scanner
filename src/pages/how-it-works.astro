---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, howItWorks, commonPorts, limitations, bannerNotes } from '../data/content.js';
---
<Layout title={`How It Works | ${site.brand}`}>
<Header/>
<main id="main-content">
  <div class="wrap page-header">
    <span class="tag" aria-hidden="true">Concept</span>
    <h1 class="page-title" style="margin-top:12px;">How It Works</h1>
    <p class="page-subtitle">A plain TCP connect scan, explained step by step.</p>
  </div>
  <section class="section"><div class="wrap prose">
    <ol class="steps">{howItWorks.map(s => <li>{s}</li>)}</ol>
    <h2>Common ports it recognises</h2>
    <table class="data-table"><thead><tr><th>Port</th><th>Service</th><th>Used for</th></tr></thead>
    <tbody>{commonPorts.map(([p,s,u]) => <tr><td>{p}</td><td>{s}</td><td>{u}</td></tr>)}</tbody></table>
    <h2>About banner grabbing</h2>
    <ul>{bannerNotes.map(n => <li class="muted" style="margin-bottom:8px;">{n}</li>)}</ul>
    <h2>Limitations</h2>
    <ul>{limitations.map(l => <li class="muted">{l}</li>)}</ul>
  </div></section>
</main>
<Footer/>
</Layout>
